# Copy to .dev.vars for local development (npm run dev). Never commit .dev.vars.
# wrangler dev rewrites the Origin header to the first route (xsim.dev), so keep those hosts listed.
# Turnstile test secret: always passes. Real secret goes in via `npx wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_HOSTS=xsim.dev,www.xsim.dev,localhost,127.0.0.1
